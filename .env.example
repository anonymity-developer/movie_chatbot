OPENAI_API_KEY=
# OPENAI_BASE_URL=
MOVIELAB_DATA_DIR=data
MOVIELAB_CHROMA_DIR=.local/chroma
MOVIELAB_CACHE_DB=.local/cache.sqlite3
MOVIELAB_EMBEDDING_MODEL=text-embedding-3-small
MOVIELAB_CHAT_MODEL=gpt-4.1-mini
MOVIELAB_CHUNK_SIZE=1000
MOVIELAB_CHUNK_OVERLAP=200
MOVIELAB_TOP_K=6
MOVIELAB_DISCOVERY_CANDIDATES=80
MOVIELAB_RETRIEVAL_STRATEGY=similarity
MOVIELAB_MMR_FETCH_K=30
MOVIELAB_WIKI_SOURCE=bundle
MOVIELAB_ENABLE_WIKIDATA=true
# Set a contact-bearing agent before enabling live Wikimedia requests.
MOVIELAB_WIKIMEDIA_USER_AGENT=
# Movie planner. Demo uses synthetic data and never calls external APIs.
PLANNER_DEMO=false
GMS_API_KEY=
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
GMS_CHAT_MODEL=gpt-5.4-nano
KOBIS_API_KEY=
KAKAO_REST_API_KEY=
