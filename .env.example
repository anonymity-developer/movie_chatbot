OPENAI_API_KEY=
# OPENAI_BASE_URL=
MOVIELAB_DATA_DIR=data
MOVIELAB_CHROMA_DIR=.local/chroma
MOVIELAB_CACHE_DB=.local/cache.sqlite3
MOVIELAB_EMBEDDING_MODEL=text-embedding-3-small
MOVIELAB_CHAT_MODEL=gpt-4.1-mini
MOVIELAB_CHUNK_SIZE=1000
MOVIELAB_CHUNK_OVERLAP=200
MOVIELAB_TOP_K=6
