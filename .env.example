# Leave these empty to reuse GMS_API_KEY for existing Movie Lab and embeddings.
OPENAI_API_KEY=
# OPENAI_BASE_URL=
MOVIELAB_DATA_DIR=data
MOVIELAB_CHROMA_DIR=.local/chroma
MOVIELAB_CACHE_DB=.local/cache.sqlite3
MOVIELAB_EMBEDDING_MODEL=text-embedding-3-small
MOVIELAB_CHAT_MODEL=gpt-4.1-mini
MOVIELAB_CHUNK_SIZE=1000
MOVIELAB_CHUNK_OVERLAP=200
MOVIELAB_TOP_K=6
MOVIELAB_DISCOVERY_CANDIDATES=80
MOVIELAB_RETRIEVAL_STRATEGY=similarity
MOVIELAB_MMR_FETCH_K=30
MOVIELAB_WIKI_SOURCE=bundle
MOVIELAB_ENABLE_WIKIDATA=true
# Set a contact-bearing agent before enabling live Wikimedia requests.
MOVIELAB_WIKIMEDIA_USER_AGENT=
# Movie planner. Demo uses synthetic data and never calls external APIs.
PLANNER_DEMO=false
GMS_API_KEY=
# OpenAI-compatible endpoint for Movie Lab and embeddings. The planner uses GMS Claude.
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
KOBIS_API_KEY=
# Public OpenStreetMap Overpass endpoint. No credentials required.
PLANNER_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Bounded, user-triggered Gangnam cinema lookup. Set empty to use Overpass only.
PLANNER_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
PLANNER_WORKER=true
PLANNER_WORKER_LLM=true
# local or google. Google is available from this machine's loopback address.
PLANNER_CALENDAR_BACKEND=local
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_CLIENT=.local/google-calendar-client.json
GOOGLE_CALENDAR_TOKEN=.local/google-calendar-token.json
